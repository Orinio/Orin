# Environment Variables for Orin Backend Server
# Copy this to .env and fill in the values

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Encryption key for tokens at rest (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NVIDIA NIM API
NVIDIA_API_KEY=nvapi-your-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# GitHub
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Stripe
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_CHECKOUT_URL=https://checkout.stripe.com/your-checkout-url
STRIPE_PORTAL_URL=https://billing.stripe.com/your-portal-url

# OAuth Integrations (optional)
# OAUTH_REDIRECT_URI=http://localhost:3001/api/integrations/callback
# GITHUB_CLIENT_ID=your-github-client-id
# GITLAB_CLIENT_ID=your-gitlab-client-id
# KAGGLE_CLIENT_ID=your-kaggle-client-id

# Search APIs (optional, DuckDuckGo fallback)
# SERPAPI_KEY=your-serpapi-key
# GOOGLE_SEARCH_API_KEY=your-google-search-api-key

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
GLOBAL_AI_RPM_LIMIT=35

# Metrics (internal API key — required in production for /metrics access)
METRICS_API_KEY=

# Web Push (VAPID) - Generate with: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@orin.app

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:3000
